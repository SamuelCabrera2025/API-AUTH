# Copie este archivo como .env y complete los valores de su Oracle local.
AUTH_PORT=8081
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USER=USUARIO_ORACLE
DB_PASSWORD=CLAVE_ORACLE
DB_DRIVER=oracle.jdbc.OracleDriver
DB_DIALECT=org.hibernate.dialect.OracleDialect

# Use una cadena aleatoria de 32 caracteres o más.
JWT_SECRET=CAMBIE_ESTA_LLAVE_POR_UNA_ALEATORIA_DE_32_CARACTERES
JWT_EXPIRATION_MS=86400000
